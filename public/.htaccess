DirectoryIndex index.html index.php
Options -Indexes

<IfModule mod_headers.c>
  # "set" (not "always set") replaces the value PHP already sends, so the header appears once
  Header set X-Content-Type-Options "nosniff"
  Header setifempty Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Embed-Skript: versioniert, lange gecacht
  RewriteRule ^v1/embed\.js$ assets/embed.v1.js [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [QSA,L]
</IfModule>

<FilesMatch "^embed\.v1\.js$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
    Header set Access-Control-Allow-Origin "*"
  </IfModule>
</FilesMatch>
