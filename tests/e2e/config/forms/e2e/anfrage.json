{
  "id": "anfrage",
  "version": 1,
  "recipient": "team",
  "redirect": { "de": "/danke/", "en": "/danke/" },
  "fields": [
    { "name": "name", "type": "text", "required": true, "maxLength": 100, "label": { "de": "Name", "en": "Name" } },
    { "name": "email", "type": "email", "required": true, "replyTo": true, "label": { "de": "E-Mail", "en": "Email" } },
    { "name": "nachricht", "type": "textarea", "required": true, "label": { "de": "Nachricht", "en": "Message" } },
    { "name": "datenschutz", "type": "consent", "required": true, "label": { "de": "Datenschutz", "en": "Privacy" } }
  ]
}
